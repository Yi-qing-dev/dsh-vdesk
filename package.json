{
  "name": "@lws31/dsh-vdesk",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的 Windows 虚拟桌面插件：静默挂载、人工输入优先、可接管。Fork 自 dsh-vdesktop (MIT, DescartHsu)。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "sidecar/dshv/**/*.py", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "inject": ["tools"]
  },
  "scripts": {
    "build": "node scripts/build-ts.mjs",
    "dev-link": "node scripts/dev-link.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "typescript": "^5.5.3",
    "@types/node": "^22.5.0"
  }
}
